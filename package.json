{
  "name": "inspark-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && node index.js",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "start": "node backend/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "livekit-server-sdk": "^2.18.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
